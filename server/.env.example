# Application Configuration
NODE_ENV=development
PORT=5173

# Monitoring & Error Tracking
# Get your DSN from https://sentry.io (free tier: 5k events/month)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Evolution API Configuration
EVOLUTION_API_URL=https://hsapi.studio/
EVOLUTION_API_KEY=Pz6qEerZE5IYwaoc8ZCQxmBdLAinX4dl

# Multiple Evolution API Servers (optional)
# EVOLUTION_API_URL_2=http://localhost:8081
# EVOLUTION_API_KEY_2=your-second-api-key
# EVOLUTION_API_URL_3=http://localhost:8082
# EVOLUTION_API_KEY_3=your-third-api-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/whatsai
DIRECT_URL=postgresql://username:password@localhost:5432/whatsai

# WebSocket Configuration (optional)
# WEBSOCKET_PORT=3001

# Redis Configuration (for BullMQ message queue - Anti-Ban system)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password # Optional: only if Redis has authentication

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create products at https://dashboard.stripe.com/test/products)
# Create a product for each plan and paste the price IDs below
STRIPE_PRICE_STARTER=price_1234567890abcdefSTARTER
STRIPE_PRICE_PRO=price_1234567890abcdefPRO
STRIPE_PRICE_BUSINESS=price_1234567890abcdefBUSINESS

# Client URL (for Stripe redirects)
CLIENT_URL=http://localhost:5173

# DigitalOcean Spaces / S3 Configuration (for media storage)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_BUCKET=whatsai-media
DO_SPACES_REGION=nyc3

# OpenAI Configuration (for AI Chatbot / GPT Integration)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7